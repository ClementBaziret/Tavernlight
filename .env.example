# PostgreSQL connection used by the server (Prisma).
DATABASE_URL=postgresql://tavernlight:tavernlight@localhost:5433/tavernlight?schema=public
# Port of the API / web server.
PORT=3000
# Comma-separated list of origins allowed to call the API with cookies (the Vite dev server in development).
CORS_ORIGINS=http://localhost:5173
# Set to "true" behind HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false
# Password of the demo accounts created by `pnpm seed:demo`.
DEMO_PASSWORD=tavernlight
